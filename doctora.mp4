        position: relative;
        user-select: none;
        width: 32px;
      }

      .rgx-button:focus {
        outline: 0;
      }

      .rgx-button-text:not([disabled]) + .rgx-button.compare-button {
         margin-left: -4px;
      }

      .rgx-button[disabled] {
        display: none;
        pointer-events: none;
      }

      .rgx-button .image {
        background-position: center;
