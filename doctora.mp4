      .custom-button-wrapper {
        box-sizing: border-box;
        overflow: visible;
        pointer-events: none;
        position: relative;
      }

      .custom-button {
        background: var(--opera-video-toolbar-custom-button-background);
        border-radius: 16px;
        font-size: 0px;
        line-height: 32px;
        pointer-events: initial;
        white-space: nowrap;
        margin: 0 2px;
        height: 32px;
